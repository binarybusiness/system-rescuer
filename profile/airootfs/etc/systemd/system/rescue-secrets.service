[Unit]
Description=Give the repair agent's secrets mounts of their own (the API key, iwd's networks)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target rescue-proxy.service iwd.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/rescue-secrets

[Install]
WantedBy=sysinit.target
