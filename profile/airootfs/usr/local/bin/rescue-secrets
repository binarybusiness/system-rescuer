#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# SPDX-FileCopyrightText: 2026 Mikael Moghadam (Binary Business)
# rescue-secrets.service, early at boot, before anything reads a secret: give
# each secret a mount of its own, which the repair agent's mount namespace
# unmounts (rescue-agent), so that no sequence of unmounts there uncovers it.
#   /run/.rescue-key  a root-only tmpfs: the DeepSeek key moves here from the
#                    image, and rescue-proxy-conf writes the proxy's auth.conf
#                    here; the image's copy is deleted from the root overlay.
#                    An image built with no key has none: rescue-agent asks
#                    for it at tty1 and writes it here.
#   /var/lib/iwd     a root-only tmpfs: the Wi-Fi networks iwd saves, on
#                    /var/lib, which becomes a mount of its own.
# The kernel propagates an unmount through the peers of the mount's parent, so
# the agent's namespace makes the parents, /run and /var/lib, slaves of the
# system's before it unmounts the secrets: a parent on the root overlay could
# not be, without cutting the agent's mounts off from the owner's sessions.
# The key goes from file to file through bash builtins, never argv or output.
set -euo pipefail
umask 077
# shellcheck source=profile/airootfs/usr/local/lib/rescue-paths.sh
. /usr/local/lib/rescue-paths.sh
image_key=$rescue_image_key
key_dir=$rescue_key_dir

mkdir -p "$key_dir"
mountpoint -q "$key_dir" || mount -t tmpfs -o size=64k,mode=700,nosuid,nodev,noexec rescue-key "$key_dir"
if [[ -f $image_key ]]; then
    key=$(<"$image_key")
    printf '%s' "$key" > "$rescue_key_file.new"
    mv -f "$rescue_key_file.new" "$rescue_key_file"
    unset key
else
    # A --no-key image: rescue-agent asks for the key on tty1 (key-at-boot).
    mkdir -p "$rescue_state_dir"
    : > "$rescue_key_at_boot"
fi
rm -rf -- "$rescue_image_key_dir"

if ! mountpoint -q /var/lib; then
    mount --bind /var/lib /var/lib
    # A peer group of its own, not the root's.
    mount --make-private /var/lib
    mount --make-shared /var/lib
fi
mkdir -p /var/lib/iwd
mountpoint -q /var/lib/iwd || mount -t tmpfs -o size=1m,mode=700,nosuid,nodev,noexec rescue-iwd /var/lib/iwd
