{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-direct/deepseek-flash",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": ["deepseek-direct"],
  "permission": {
    "*": "allow",
    "read": { "*": "allow", "/run/.rescue-key": "deny", "/run/.rescue-key/*": "deny" },
    "list": { "*": "allow", "/run/.rescue-key": "deny", "/run/.rescue-key/*": "deny" },
    "bash": { "*": "allow", "*/run/.rescue-key*": "deny", "*deepseek-key*": "deny" },
    "shell": { "*": "allow", "*/run/.rescue-key*": "deny", "*deepseek-key*": "deny" }
  },
  "provider": {
    "deepseek-direct": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (direct)",
      "options": {
        "baseURL": "http://127.0.0.1:8484/v1",
        "apiKey": "added-by-rescue-proxy",
        "headerTimeout": 120000,
        "chunkTimeout": 120000
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash",
          "tool_call": true,
          "limit": { "context": 256000, "output": 32768 },
          "cost": { "input": 0.30, "output": 1.20, "cache_read": 0.006 }
        }
      }
    }
  }
}
